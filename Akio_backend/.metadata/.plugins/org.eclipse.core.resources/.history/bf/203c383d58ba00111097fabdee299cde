package com.akio.backend.controller;

import org.springframework.web.bind.annotation.*;

import com.akio.backend.service.GeminiService;

@RestController
@RequestMapping("/api/akio")
public class AkioController {

    private final GeminiService geminiService;

    public AkioController(GeminiService geminiService) {
        this.geminiService = geminiService;
    }

    @PostMapping("/chat")
    public String chat(@RequestBody String message) {

        System.out.println("Received: " + message);

        return geminiService.generateResponse(message);
    }
}