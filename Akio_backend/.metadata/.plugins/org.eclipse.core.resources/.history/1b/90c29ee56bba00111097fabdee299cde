package com.akio.backend.controller;

import com.akio.backend.dto.ChatRequest;
import com.akio.backend.dto.ChatResponse;
import com.akio.backend.service.GeminiService;
import com.akio.backend.service.PiperService;

import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

@RestController
@RequestMapping("/api/akio")
public class AkioController {

    private final GeminiService geminiService;
    private final PiperService piperService;

    public AkioController(
            GeminiService geminiService,
            PiperService piperService) {

        this.geminiService = geminiService;
        this.piperService = piperService;
    }

    // =========================
    // TEXT CHAT
    // =========================

    @PostMapping("/chat")
    public ChatResponse chat(@RequestBody ChatRequest request) {

        String response =
                geminiService.generateResponse(request.getMessage());

        return new ChatResponse(response);
    }


    // =========================
    // SPEAK - POST
    // =========================

    @PostMapping(
            value = "/speak",
            produces = "audio/wav"
    )
    public ResponseEntity<byte[]> speak(
            @RequestBody ChatRequest request) {

        System.out.println("AKIO request: "
                + request.getMessage());

        String response =
                geminiService.generateResponse(
                        request.getMessage()
                );

        System.out.println("Gemini response: "
                + response);

        byte[] audio =
                piperService.synthesize(response);

        System.out.println("Audio generated: "
                + audio.length + " bytes");

        return ResponseEntity.ok()
                .contentType(
                        MediaType.parseMediaType("audio/wav")
                )
                .body(audio);
    }


    // =========================
    // SPEAK - GET
    // =========================

    @GetMapping(
            value = "/speak",
            produces = "audio/wav"
    )
    public ResponseEntity<byte[]> speakGet(
            @RequestParam String message) {

        System.out.println("AKIO GET request: "
                + message);

        String response =
                geminiService.generateResponse(message);

        System.out.println("Gemini response: "
                + response);

        byte[] audio =
                piperService.synthesize(response);

        System.out.println("Audio generated: "
                + audio.length + " bytes");

        return ResponseEntity.ok()
                .contentType(
                        MediaType.parseMediaType("audio/wav")
                )
                .body(audio);
    }
}